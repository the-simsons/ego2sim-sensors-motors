<?xml version="1.0"?>
<package format="3">
  <name>ego2sim_backend</name><version>0.1.0</version>
  <description>Serial acquisition, calibrated sensor processing and mock transport.</description>
  <maintainer email="maintainers@example.com">Ego2Sim maintainers</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>python3-serial</exec_depend>
  <exec_depend>ego2sim_interfaces</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>launch</exec_depend><exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
